# ============================================================================
#  喜马拉雅自动提现 · 环境变量样例
#  复制本文件内容到你的环境变量面板（青龙/Dumb-Panel/docker env 均可）
#
#  ★ 必填 4 项：XMLY_COOKIE / XMLY_RSA_PUBKEY / XMLY_RSA_SALT / XMLY_SECURITY_CONFIG_ID
#     少任何一个都会报「RSA 公钥解析失败」或签名失败
# ============================================================================

# ---------- 必填 1：账号列表 ----------
# 一行一个账号，格式：备注#Cookie#代理#渠道
#   备注、代理、渠道都可省略
#   代理留空=直连，支持 socks5://user:pass@host:port 或 http://host:port
#   渠道可选 wechat / alipay，留空则用 XMLY_WITHDRAW_CHANNEL
XMLY_COOKIE=我的号#1&_device=android&xxxx;1&_token=123456&yyyy;...##wechat

# ---------- 必填 2：RSA 公钥（392 字符，少一位就报解析失败）----------
XMLY_RSA_

# ---------- 必填 3：RSA 盐（16 字符）----------
XMLY_RSA_SALT=7UlJQvyrOitbIcD4

# ---------- 必填 4：安全配置 ID ----------
XMLY_SECURITY_CONFIG_ID=2888001

# ---------- 提现行为 ----------
# 运行模式：grab=守点抢兑，check=只检查不提交
XMLY_WITHDRAW_MODE=grab

# 默认渠道（账号未单独指定时生效）
XMLY_WITHDRAW_CHANNEL=wechat

# 抢兑档位优先级（从高到低）
# 5=五元 3=三元 1=一元 0.3=三毛
# 注意：10 元档需连续签到 7 天，一般不放进来
XMLY_WITHDRAW_AMOUNT=5,3,1,0.3

# 只抢 >= 该金额的档位（避免白天就把小额次数用掉）
XMLY_MIN_AMOUNT=3

# 是否全天放开小额（1=放开，0=按 MIN_AMOUNT 限制）
XMLY_ALLOW_SMALL=0

# 最后一个场次（20点）自动放开小额兜底
XMLY_AUTO_SMALL_LAST=1

# 并发探测线程数（越大抢得越快，但更容易触发限流）
XMLY_CONCURRENCY=4

# 每个场次抢多久（秒）
XMLY_WITHDRAW_GRAB_SECONDS=300

# 轮询间隔（毫秒）
XMLY_WITHDRAW_INTERVAL_MS=800

# 刷新点前后提速间隔（毫秒）
XMLY_WITHDRAW_INTERVAL_FAST_MS=250

# 刷新点前后多少秒内提速
XMLY_GRAB_FAST_WINDOW=15

# 额度刷新小时（逗号分隔）
XMLY_QUOTA_REFRESH_HOURS=0,8,12,16,20

# 提前多少秒开始轮询
XMLY_GRAB_LEAD=3

# cron 提前量（调度器有延迟时调大）
XMLY_GRAB_MAX_WAIT=360

# 本渠道无档位时是否尝试其他已绑卡渠道
XMLY_WITHDRAW_CROSS_CHANNEL=1

# ---------- 应用信息（一般不用改）----------
XMLY_APPVER=9.5.13.3
XMLY_APPVER_SHORT=9.5.13
XMLY_UA=ting_9.5.13(2509FPN0BC,Android37)
